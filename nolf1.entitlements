<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- nolf1 dlopens its own game module, libnolfobject.dylib. Under the
	     hardened runtime, library validation refuses a dylib that is not
	     signed by the same team ("different Team IDs") -- the black screen
	     of HANDOVER 5cq. -->
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
</dict>
</plist>
